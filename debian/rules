#!/usr/bin/make -f
export PYBUILD_NAME=activitytrack
# the tests import the package from the build tree: they go there with it
export PYBUILD_BEFORE_TEST=cp -r {dir}/tests {build_dir}
export PYBUILD_AFTER_TEST=rm -rf {build_dir}/tests
export PYBUILD_TEST_ARGS=discover -s tests -t {build_dir}

%:
	dh $@ --buildsystem=pybuild
